# Local configuration for the CIS 3339 Homework 1 backend.
# This file is intentionally committed to Git (assignment requirement).
# It contains no passwords or secrets – only a local MongoDB Community Edition URI.

# MongoDB connection string (local MongoDB Community Edition, no authentication).
# The database is created automatically on first use.
MONGODB_URI=mongodb://127.0.0.1:27017/cis3339_homework1

# Port the Express server listens on. Open http://localhost:3000 in a browser.
PORT=3000
